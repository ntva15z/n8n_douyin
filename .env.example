# ===========================================
# DOUYIN VIDEO WORKFLOW - ENVIRONMENT CONFIG
# ===========================================

# Google Sheets - ID của sheet chứa danh sách kênh Douyin
# Lấy từ URL: https://docs.google.com/spreadsheets/d/{GOOGLE_SHEET_ID}/edit
GOOGLE_SHEET_ID=

# Google Drive - ID folder để lưu video đã xử lý
# Lấy từ URL: https://drive.google.com/drive/folders/{GOOGLE_DRIVE_FOLDER_ID}
GOOGLE_DRIVE_FOLDER_ID=

# OpenAI API Key - Dùng cho dịch thuật
# Lấy từ: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional - Webhook để gửi alert khi có lỗi (Slack/Discord)
ALERT_WEBHOOK_URL=

# Note: OCR sử dụng PaddleOCR (free, chạy local trong Docker)
# Không cần API key
