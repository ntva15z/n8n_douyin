# Google APIs
GOOGLE_SHEET_ID=your_sheet_id
GOOGLE_DRIVE_FOLDER_ID=your_folder_id
GOOGLE_CREDENTIALS=path/to/credentials.json

# OCR Service (Baidu OCR)
OCR_API_KEY=your_ocr_api_key
OCR_SECRET_KEY=your_ocr_secret_key
OCR_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/general

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Optional - Alert notifications
ALERT_WEBHOOK_URL=your_slack_or_discord_webhook

# Storage paths
TEMP_VIDEO_PATH=./temp/videos
OUTPUT_VIDEO_PATH=./output/videos
