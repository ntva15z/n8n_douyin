FROM node:20-slim

# Install system dependencies including Playwright deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \

    && rm -rf /var/lib/apt/lists/*

# Create virtual environment and install Python packages
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install EasyOCR for text detection
RUN pip install --no-cache-dir easyocr

# Pre-download EasyOCR models to avoid runtime download
RUN python3 -c "import easyocr; easyocr.Reader(['ch_sim'], gpu=False, verbose=True)"

# Create app directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev for build)
RUN npm install

# Copy source code
COPY src/ ./src/
COPY tsconfig.json ./

# Build TypeScript
RUN npm run build

# Create directories
RUN mkdir -p /app/temp /app/output /app/credentials

# Expose port for API
EXPOSE 3000

# Run worker server
CMD ["node", "dist/worker-server.js"]
