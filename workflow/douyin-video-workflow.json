{
  "name": "Douyin Video Workflow - Step by Step",
  "nodes": [
    {
      "id": "trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] }
      }
    },
    {
      "id": "read-sheet",
      "name": "Read Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 300],
      "parameters": {
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sheet1" },
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "", "name": "" } }
    },
    {
      "id": "filter-started",
      "name": "Filter Started & Has URL",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.status }}", "rightValue": "Started", "operator": { "type": "string", "operation": "equals" } },
            { "id": "c2", "leftValue": "={{ $json.video_url }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "set-context",
      "name": "Set Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 300],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "video_url", "type": "string", "value": "={{ $json.video_url }}" },
            { "id": "a2", "name": "row_index", "type": "number", "value": "={{ $runIndex + 2 }}" }
          ]
        },
        "options": {}
      }
    },

    {
      "id": "step1-download",
      "name": "Step 1: Download Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300],
      "parameters": {
        "method": "POST",
        "url": "http://worker:3000/step/download",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"video_url\": \"{{ $json.video_url }}\" }",
        "options": { "timeout": 300000 }
      }
    },
    {
      "id": "check-download",
      "name": "Download OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.success }}", "rightValue": "={{ true }}", "operator": { "type": "boolean", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step2-extract",
      "name": "Step 2: Extract Subtitles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 200],
      "parameters": {
        "method": "POST",
        "url": "http://worker:3000/step/extract",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"video_id\": \"{{ $json.video_id }}\", \"video_path\": \"{{ $json.video_path }}\" }",
        "options": { "timeout": 600000 }
      }
    },
    {
      "id": "check-extract",
      "name": "Extract OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1540, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.success }}", "rightValue": "={{ true }}", "operator": { "type": "boolean", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },

    {
      "id": "step3-translate",
      "name": "Step 3: Translate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 100],
      "parameters": {
        "method": "POST",
        "url": "http://worker:3000/step/translate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"video_id\": \"{{ $('Step 1: Download Video').item.json.video_id }}\", \"segments\": {{ JSON.stringify($json.segments) }} }",
        "options": { "timeout": 300000 }
      }
    },
    {
      "id": "check-translate",
      "name": "Translate OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1980, 100],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.success }}", "rightValue": "={{ true }}", "operator": { "type": "boolean", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step4-embed",
      "name": "Step 4: Embed Subtitles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 0],
      "parameters": {
        "method": "POST",
        "url": "http://worker:3000/step/embed",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"video_id\": \"{{ $('Step 1: Download Video').item.json.video_id }}\", \"video_path\": \"{{ $('Step 1: Download Video').item.json.video_path }}\", \"srt_path\": \"{{ $json.srt_path }}\" }",
        "options": { "timeout": 600000 }
      }
    },
    {
      "id": "check-embed",
      "name": "Embed OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2420, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.success }}", "rightValue": "={{ true }}", "operator": { "type": "boolean", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },

    {
      "id": "step5-upload",
      "name": "Step 5: Upload to Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2640, -100],
      "parameters": {
        "method": "POST",
        "url": "http://worker:3000/step/upload",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"video_id\": \"{{ $('Step 1: Download Video').item.json.video_id }}\", \"file_path\": \"{{ $json.output_path }}\" }",
        "options": { "timeout": 300000 }
      }
    },
    {
      "id": "check-upload",
      "name": "Upload OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2860, -100],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.success }}", "rightValue": "={{ true }}", "operator": { "type": "boolean", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step6-cleanup",
      "name": "Step 6: Cleanup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3080, -200],
      "parameters": {
        "method": "POST",
        "url": "http://worker:3000/step/cleanup",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"video_id\": \"{{ $('Step 1: Download Video').item.json.video_id }}\" }",
        "options": { "timeout": 60000 }
      }
    },
    {
      "id": "update-success",
      "name": "Update Sheet: Success",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [3300, -200],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "video_url": "={{ $('Set Context').item.json.video_url }}",
            "status": "Stopped",
            "output_location": "={{ $('Step 5: Upload to Drive').item.json.drive_link }}",
            "processing_status": "Completed"
          }
        },
        "matchingColumns": ["video_url"],
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "", "name": "" } }
    },

    {
      "id": "update-failed-download",
      "name": "Update Sheet: Download Failed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1320, 400],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "video_url": "={{ $('Set Context').item.json.video_url }}",
            "status": "Started",
            "processing_status": "Download_Failed",
            "output_location": "={{ $json.error }}"
          }
        },
        "matchingColumns": ["video_url"],
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "", "name": "" } }
    },
    {
      "id": "update-failed-extract",
      "name": "Update Sheet: Extract Failed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1760, 300],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "video_url": "={{ $('Set Context').item.json.video_url }}",
            "status": "Started",
            "processing_status": "Extract_Failed",
            "output_location": "={{ $json.error }}"
          }
        },
        "matchingColumns": ["video_url"],
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "", "name": "" } }
    },
    {
      "id": "update-failed-translate",
      "name": "Update Sheet: Translate Failed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2200, 200],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "video_url": "={{ $('Set Context').item.json.video_url }}",
            "status": "Started",
            "processing_status": "Translate_Failed",
            "output_location": "={{ $json.error }}"
          }
        },
        "matchingColumns": ["video_url"],
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "", "name": "" } }
    },

    {
      "id": "update-failed-embed",
      "name": "Update Sheet: Embed Failed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2640, 100],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "video_url": "={{ $('Set Context').item.json.video_url }}",
            "status": "Started",
            "processing_status": "Embed_Failed",
            "output_location": "={{ $json.error }}"
          }
        },
        "matchingColumns": ["video_url"],
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "", "name": "" } }
    },
    {
      "id": "update-failed-upload",
      "name": "Update Sheet: Upload Failed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [3080, 0],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "video_url": "={{ $('Set Context').item.json.video_url }}",
            "status": "Started",
            "processing_status": "Upload_Failed",
            "output_location": "={{ $json.error }}"
          }
        },
        "matchingColumns": ["video_url"],
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "", "name": "" } }
    }
  ],

  "connections": {
    "Schedule Trigger": { 
      "main": [[{ "node": "Read Google Sheet", "type": "main", "index": 0 }]] 
    },
    "Read Google Sheet": { 
      "main": [[{ "node": "Filter Started & Has URL", "type": "main", "index": 0 }]] 
    },
    "Filter Started & Has URL": { 
      "main": [[{ "node": "Set Context", "type": "main", "index": 0 }]] 
    },
    "Set Context": { 
      "main": [[{ "node": "Step 1: Download Video", "type": "main", "index": 0 }]] 
    },
    "Step 1: Download Video": { 
      "main": [[{ "node": "Download OK?", "type": "main", "index": 0 }]] 
    },
    "Download OK?": { 
      "main": [
        [{ "node": "Step 2: Extract Subtitles", "type": "main", "index": 0 }],
        [{ "node": "Update Sheet: Download Failed", "type": "main", "index": 0 }]
      ] 
    },
    "Step 2: Extract Subtitles": { 
      "main": [[{ "node": "Extract OK?", "type": "main", "index": 0 }]] 
    },
    "Extract OK?": { 
      "main": [
        [{ "node": "Step 3: Translate", "type": "main", "index": 0 }],
        [{ "node": "Update Sheet: Extract Failed", "type": "main", "index": 0 }]
      ] 
    },
    "Step 3: Translate": { 
      "main": [[{ "node": "Translate OK?", "type": "main", "index": 0 }]] 
    },
    "Translate OK?": { 
      "main": [
        [{ "node": "Step 4: Embed Subtitles", "type": "main", "index": 0 }],
        [{ "node": "Update Sheet: Translate Failed", "type": "main", "index": 0 }]
      ] 
    },
    "Step 4: Embed Subtitles": { 
      "main": [[{ "node": "Embed OK?", "type": "main", "index": 0 }]] 
    },
    "Embed OK?": { 
      "main": [
        [{ "node": "Step 5: Upload to Drive", "type": "main", "index": 0 }],
        [{ "node": "Update Sheet: Embed Failed", "type": "main", "index": 0 }]
      ] 
    },
    "Step 5: Upload to Drive": { 
      "main": [[{ "node": "Upload OK?", "type": "main", "index": 0 }]] 
    },
    "Upload OK?": { 
      "main": [
        [{ "node": "Step 6: Cleanup", "type": "main", "index": 0 }],
        [{ "node": "Update Sheet: Upload Failed", "type": "main", "index": 0 }]
      ] 
    },
    "Step 6: Cleanup": { 
      "main": [[{ "node": "Update Sheet: Success", "type": "main", "index": 0 }]] 
    }
  },
  "settings": { 
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  }
}
