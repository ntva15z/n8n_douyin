    },
    {
      "parameters": {
        "jsCode": "// Embed subtitles using FFmpeg\nconst { exec } = require('child_process');\nconst util = require('util');\nconst fs = require('fs');\nconst execAsync = util.promisify(exec);\n\nconst video = $input.first().json;\nconst srtPath = `/tmp/videos/${video.id}.srt`;\nconst outputPath = `/tmp/videos/${video.id}_subtitled.mp4`;\n\n// Write SRT file\nfs.writeFileSync(srtPath, video.vietnameseSrt || video.message?.content);\n\ntry {\n  await execAsync(\n    `ffmpeg -i \"${video.localPath}\" -vf \"subtitles='${srtPath}'\" -c:a copy \"${outputPath}\" -y`,\n    { maxBuffer: 100 * 1024 * 1024 }\n  );\n  \n  return [{\n    json: {\n      ...video,\n      outputPath: outputPath\n    }\n  }];\n} catch (error) {\n  throw new Error(`Failed to embed subtitles: ${error.message}`);\n}"
      },
      "id": "embed-subtitles",
      "name": "Embed Subtitles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3080, 0]
    },
    {
      "parameters": {
        "operation": "upload",
        "folderId": "={{ $env.GOOGLE_DRIVE_FOLDER_ID }}",
        "name": "={{ $json.id }}_subtitled.mp4",
        "binaryPropertyName": "data"
      },
      "id": "upload-drive",
