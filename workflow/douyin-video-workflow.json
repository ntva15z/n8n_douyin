          "string": [
            {
              "value1": "={{ $json.user_id }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.lastprocess }}",
              "operation": "isNotEmpty"
            }
          ]
        },
        "combineConditions": "and"
      },
      "id": "validate-rows",
      "name": "Validate Required Fields",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 1,
      "position": [660, 0]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-channels",
      "name": "Loop Channels",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [880, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "sheetId": "={{ $env.GOOGLE_SHEET_ID }}",
        "range": "Sheet1!E{{ $json.row_number }}",
        "valueInputMode": "RAW",
        "values": "Processing"
      },
      "id": "update-status-processing",
      "name": "Update Status: Processing",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [1100, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-cred",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Download videos using yt-dlp\nconst { exec } = require('child_process');\nconst util = require('util');\nconst execAsync = util.promisify(exec);\n\nconst userId = $input.first().json.user_id;\nconst lastprocess = $input.first().json.lastprocess;\nconst userUrl = `https://www.douyin.com/user/${userId}`;\n\ntry {\n  // Get video list\n  const { stdout } = await execAsync(\n    `yt-dlp --flat-playlist --dump-json \"${userUrl}\"`,\n    { maxBuffer: 50 * 1024 * 1024 }\n  );\n  \n  const videos = stdout.trim().split('\\n')\n    .filter(line => line.trim())\n    .map(line => JSON.parse(line))\n    .filter(video => {\n      const publishDate = new Date(video.timestamp * 1000);\n      return publishDate >= new Date(lastprocess);\n    });\n  \n  return videos.map(v => ({\n    json: {\n      id: v.id,\n      title: v.title || v.description,\n      url: v.url || v.webpage_url,\n      duration: v.duration,\n      publishDate: new Date(v.timestamp * 1000).toISOString(),\n      user_id: userId,\n      row_number: $input.first().json.row_number\n    }\n  }));\n} catch (error) {\n  throw new Error(`Failed to fetch videos: ${error.message}`);\n}"
      },
      "id": "fetch-videos",
      "name": "Fetch Douyin Videos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "sheetId": "={{ $env.GOOGLE_SHEET_ID }}",
        "range": "Sheet1!E{{ $json.row_number }}",
        "valueInputMode": "RAW",
        "values": "Downloading"
      },
      "id": "update-status-downloading",
      "name": "Update Status: Downloading",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [1540, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-cred",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Download video file\nconst { exec } = require('child_process');\nconst util = require('util');\nconst path = require('path');\nconst execAsync = util.promisify(exec);\n\nconst video = $input.first().json;\nconst outputPath = `/tmp/videos/${video.id}.mp4`;\n\ntry {\n  await execAsync(\n    `yt-dlp -o \"${outputPath}\" \"${video.url}\"`,\n    { maxBuffer: 100 * 1024 * 1024 }\n  );\n  \n  return [{\n    json: {\n      ...video,\n      localPath: outputPath\n    }\n  }];\n} catch (error) {\n  throw new Error(`Failed to download video: ${error.message}`);\n}"
      },
      "id": "download-video",
      "name": "Download Video",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "sheetId": "={{ $env.GOOGLE_SHEET_ID }}",
        "range": "Sheet1!E{{ $json.row_number }}",
        "valueInputMode": "RAW",
        "values": "OCR_Processing"
      },
      "id": "update-status-ocr",
      "name": "Update Status: OCR",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [1980, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-cred",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// OCR Processing - Extract text from video frames\n// This is a placeholder - integrate with your OCR service\nconst video = $input.first().json;\n\n// Simulate OCR result\nconst srtContent = `1\n00:00:01,000 --> 00:00:05,000\n示例字幕文本\n\n2\n00:00:05,500 --> 00:00:10,000\n更多字幕内容`;\n\nreturn [{\n  json: {\n    ...video,\n    chineseSrt: srtContent\n  }\n}];"
      },
      "id": "ocr-process",
      "name": "OCR Process",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "sheetId": "={{ $env.GOOGLE_SHEET_ID }}",
        "range": "Sheet1!E{{ $json.row_number }}",
        "valueInputMode": "RAW",
        "values": "Translating"
      },
      "id": "update-status-translating",
      "name": "Update Status: Translating",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [2420, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-cred",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-4o-mini"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": \"Translate the following Chinese subtitle text to Vietnamese. Keep the same line structure and timing markers. Only output the translated text.\\n\\n{{ $json.chineseSrt }}\"}]"
            },
            {
              "name": "temperature",
              "value": "0.3"
            }
          ]
        },
        "options": {}
      },
      "id": "translate",
      "name": "Translate with OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2640, 0],
