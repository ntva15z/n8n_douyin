{
  "name": "Douyin Video Workflow",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] }
      },
      "id": "trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sheet1" },
        "options": {}
      },
      "id": "read-sheet",
      "name": "Read Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 0],
      "credentials": { "googleSheetsOAuth2Api": { "id": "", "name": "" } }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map((item, index) => ({ json: { ...item.json, row_number: index + 2 } }));"
      },
      "id": "add-row-numbers",
      "name": "Add Row Numbers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.status }}", "rightValue": "Started", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-started",
      "name": "Filter Started",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.video_url }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "validate-url",
      "name": "Has Video URL?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nreturn [{ json: { video_url: item.json.video_url, row_number: item.json.row_number } }];"
      },
      "id": "save-input",
      "name": "Save Input Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://worker:3000/process-video",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"video_url\": \"{{ $json.video_url }}\", \"row_number\": {{ $json.row_number }} }",
        "options": { "timeout": 900000 }
      },
      "id": "process-video",
      "name": "Process Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.success }}", "rightValue": "={{ true }}", "operator": { "type": "boolean", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-success",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1540, 0]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "video_url": "={{ $('Save Input Data').item.json.video_url }}",
            "status": "Stopped",
            "output_location": "={{ $('Process Video').item.json.drive_link }}",
            "processing_status": "Completed"
          }
        },
        "matchingColumns": ["video_url"],
        "options": {}
      },
      "id": "update-success",
      "name": "Update Sheet Success",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1760, -100],
      "credentials": { "googleSheetsOAuth2Api": { "id": "", "name": "" } }
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "video_url": "={{ $('Save Input Data').item.json.video_url }}",
            "status": "Started",
            "output_location": "={{ $('Process Video').item.json.error }}",
            "processing_status": "Failed"
          }
        },
        "matchingColumns": ["video_url"],
        "options": {}
      },
      "id": "update-failed",
      "name": "Update Sheet Failed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1760, 100],
      "credentials": { "googleSheetsOAuth2Api": { "id": "", "name": "" } }
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "Read Google Sheet", "type": "main", "index": 0 }]] },
    "Read Google Sheet": { "main": [[{ "node": "Add Row Numbers", "type": "main", "index": 0 }]] },
    "Add Row Numbers": { "main": [[{ "node": "Filter Started", "type": "main", "index": 0 }]] },
    "Filter Started": { "main": [[{ "node": "Has Video URL?", "type": "main", "index": 0 }]] },
    "Has Video URL?": { "main": [[{ "node": "Save Input Data", "type": "main", "index": 0 }]] },
    "Save Input Data": { "main": [[{ "node": "Process Video", "type": "main", "index": 0 }]] },
    "Process Video": { "main": [[{ "node": "Success?", "type": "main", "index": 0 }]] },
    "Success?": { 
      "main": [
        [{ "node": "Update Sheet Success", "type": "main", "index": 0 }],
        [{ "node": "Update Sheet Failed", "type": "main", "index": 0 }]
      ] 
    }
  },
  "settings": { "executionOrder": "v1" }
}
